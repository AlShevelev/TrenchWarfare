<map version="1.10" tiledversion="1.11.0" orientation="hexagonal" renderorder="right-up" width="15" height="12" tilewidth="74" tileheight="64" infinite="0" hexsidelength="37" staggeraxis="x" staggerindex="odd" nextlayerid="6" nextobjectid="58">
 <properties>
  <property name="metadata" value="{ &quot;version&quot;: 1, &quot;title&quot;: { &quot;en&quot;: &quot;Battle of Cantigny&quot;, &quot;ru&quot;: &quot;Битва при Кантиньи&quot; }, &quot;description&quot;: { &quot;en&quot;: &quot;The Battle of Cantigny, fought on May 28, 1918, was the first major American offensive in World War I and the U.S. Army’s first significant victory on the Western Front. U.S. troops captured the French village Cantigny from German forces in about half an hour, then held it against repeated counterattacks for the next two days.\n\nThough the battle was small by Western Front standards, it boosted Allied morale and showed that American soldiers could fight effectively in trench warfare.&quot;, &quot;ru&quot;: &quot;Битва при Кантиньи, произошедшая 28 мая 1918 года, стала первым крупным американским наступлением в Первой мировой войне и первой значительной победой армии США на Западном фронте. Американские войска захватили французскую деревню Кантиньи у немецких войск примерно за полчаса, а затем удерживали её от неоднократных контратак в течение следующих двух дней.\n\nХотя битва по меркам Западного фронта была небольшой, она подняла боевой дух союзников и показала, что американские солдаты могут эффективно сражаться в окопной войне.&quot; }, &quot;dates&quot;: { &quot;from&quot;: &quot;1918-05-28&quot;, &quot;to&quot;: &quot;1918-05-28&quot; }, &quot;params&quot;: { &quot;land_only_ai&quot;: true }, &quot;nations&quot;: [ { &quot;code&quot;: &quot;germany&quot;, &quot;aggressiveness&quot;: &quot;aggressive&quot;, &quot;startMoney&quot;: 2000, &quot;startIndustryPoints&quot;: 1000 }, { &quot;code&quot;: &quot;usa&quot;, &quot;aggressiveness&quot;: &quot;aggressive&quot;, &quot;startMoney&quot;: 1000, &quot;startIndustryPoints&quot;: 500 }, { &quot;code&quot;: &quot;france&quot;, &quot;aggressiveness&quot;: &quot;aggressive&quot;, &quot;startMoney&quot;: 1000, &quot;startIndustryPoints&quot;: 500 } ], &quot;diplomacy&quot;: [ { &quot;firstNation&quot;: &quot;germany&quot;, &quot;secondNation&quot;: &quot;usa&quot;, &quot;relationship&quot;: &quot;war&quot; }, { &quot;firstNation&quot;: &quot;germany&quot;, &quot;secondNation&quot;: &quot;france&quot;, &quot;relationship&quot;: &quot;war&quot; }, { &quot;firstNation&quot;: &quot;usa&quot;, &quot;secondNation&quot;: &quot;france&quot;, &quot;relationship&quot;: &quot;allied&quot; } ] }"/>
