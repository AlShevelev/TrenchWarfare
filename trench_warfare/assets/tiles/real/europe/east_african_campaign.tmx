<map version="1.10" tiledversion="1.11.0" orientation="hexagonal" renderorder="right-up" width="32" height="30" tilewidth="74" tileheight="64" infinite="0" hexsidelength="37" staggeraxis="x" staggerindex="odd" nextlayerid="6" nextobjectid="104">
 <properties>
  <property name="metadata" value="{ &quot;version&quot;: 1, &quot;title&quot;: { &quot;en&quot;: &quot;East African campaign&quot;, &quot;ru&quot;: &quot;Восточноафриканская кампания&quot; }, &quot;description&quot;: { &quot;en&quot;: &quot;The East African campaign was the First World War fighting in German East Africa, where German commander Paul von Lettow-Vorbeck used guerrilla tactics to tie down much larger Allied forces. It was unusually long and harsh, with disease, starvation, and the demands on porters causing many more deaths than direct combat.\n\nWhen the war ended in 1918, German East Africa was divided between Britain, Belgium, and Portugal, reshaping the region’s future.&quot;, &quot;ru&quot;: &quot;Восточноафриканская кампания представляла собой боевые действия Первой мировой войны на территории Германской Восточной Африки, где немецкий командующий Пауль фон Леттов-Форбек применял партизанскую тактику, чтобы сковать значительно превосходящие силы союзников. Эта кампания отличалась исключительной продолжительностью и суровостью: болезни, голод и тяжелейшие условия труда носильщиков унесли гораздо больше жизней, чем непосредственные боестолкновения.\n\nПосле окончания войны в 1918 году Германская Восточная Африка была разделена между Великобританией, Бельгией и Португалией, что предопределило дальнейшую судьбу этого региона.&quot; }, &quot;dates&quot;: { &quot;from&quot;: &quot;1914-08-03&quot;, &quot;to&quot;: &quot;1918-11-25&quot; }, &quot;params&quot;: { &quot;land_only_ai&quot;: true }, &quot;nations&quot;: [ { &quot;code&quot;: &quot;belgium&quot;, &quot;aggressiveness&quot;: &quot;aggressive&quot;, &quot;startMoney&quot;: 2000, &quot;startIndustryPoints&quot;: 1000 }, { &quot;code&quot;: &quot;greatBritain&quot;, &quot;aggressiveness&quot;: &quot;aggressive&quot;, &quot;startMoney&quot;: 2000, &quot;startIndustryPoints&quot;: 1000 }, { &quot;code&quot;: &quot;germany&quot;, &quot;aggressiveness&quot;: &quot;aggressive&quot;, &quot;startMoney&quot;: 3000, &quot;startIndustryPoints&quot;: 1500 } ], &quot;diplomacy&quot;: [ { &quot;firstNation&quot;: &quot;belgium&quot;, &quot;secondNation&quot;: &quot;germany&quot;, &quot;relationship&quot;: &quot;war&quot; }, { &quot;firstNation&quot;: &quot;greatBritain&quot;, &quot;secondNation&quot;: &quot;germany&quot;, &quot;relationship&quot;: &quot;war&quot; }, { &quot;firstNation&quot;: &quot;belgium&quot;, &quot;secondNation&quot;: &quot;greatBritain&quot;, &quot;relationship&quot;: &quot;allied&quot; } ] }"/>
