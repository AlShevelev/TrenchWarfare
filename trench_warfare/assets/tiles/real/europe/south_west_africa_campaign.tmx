<map version="1.10" tiledversion="1.11.0" orientation="hexagonal" renderorder="right-up" width="25" height="30" tilewidth="74" tileheight="64" infinite="0" hexsidelength="37" staggeraxis="x" staggerindex="odd" nextlayerid="6" nextobjectid="81">
 <properties>
  <property name="metadata" value="{ &quot;version&quot;: 1, &quot;title&quot;: { &quot;en&quot;: &quot;South West Africa campaign&quot;, &quot;ru&quot;: &quot;Кампания в Юго-Западной Африке&quot;, &quot;es&quot;: &quot;Campaña de África del Sudoeste&quot; }, &quot;description&quot;: { &quot;en&quot;: &quot;The South West Africa campaign was a World War I offensive in which Great Britain forces invaded German South-West Africa, to stop German use of its ports and wireless stations. After fighting in harsh desert conditions, british troops occupied Windhoek and pushed the Germans into the northwest corner of the territory.\n\nThe campaign ended with a German surrender, becoming one of the first major Allied successes of the war and a victory won with relatively low casualties.&quot;, &quot;ru&quot;: &quot;Юго-Западная Африканская кампания — это наступление в Первой мировой войне, в ходе которого британские войска вторглись в Германскую Юго-Западную Африку, чтобы помешать Германии использовать её порты и радиостанции. После боев в суровых условиях пустыни британские войска заняли Виндхук и оттеснили немцев в северо-западный угол территории.\n\nКампания завершилась капитуляцией Германии, став одним из первых крупных успехов союзников в войне и победой, одержанной с относительно небольшими потерями.&quot;, &quot;es&quot;: &quot;Campaña de África del Sudoeste fue una ofensiva de la Primera Guerra Mundial en la que las tropas británicas invadieron el África sudoccidental alemana para impedir que Alemania utilizara sus puertos y estaciones de radio. Tras los combates en las duras condiciones del desierto, las tropas británicas ocuparon Windhoek y hicieron retroceder a los alemanes hasta el extremo noroeste del territorio.\n\nLa campaña concluyó con la capitulación de Alemania, convirtiéndose en uno de los primeros grandes éxitos de los aliados en la guerra y en una victoria obtenida con pérdidas relativamente escasas.&quot; }, &quot;dates&quot;: { &quot;from&quot;: &quot;1914-09-15&quot;, &quot;to&quot;: &quot;1915-07-09&quot; }, &quot;params&quot;: { &quot;land_only_ai&quot;: true }, &quot;nations&quot;: [ { &quot;code&quot;: &quot;germany&quot;, &quot;aggressiveness&quot;: &quot;aggressive&quot;, &quot;startMoney&quot;: 1500, &quot;startIndustryPoints&quot;: 750 }, { &quot;code&quot;: &quot;greatBritain&quot;, &quot;aggressiveness&quot;: &quot;aggressive&quot;, &quot;startMoney&quot;: 2000, &quot;startIndustryPoints&quot;: 1000 } ], &quot;diplomacy&quot;: [ { &quot;firstNation&quot;: &quot;germany&quot;, &quot;secondNation&quot;: &quot;greatBritain&quot;, &quot;relationship&quot;: &quot;war&quot; } ] }"/>
 </properties>
